---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Projects from '../components/Projects.astro';
import Skills from '../components/Skills.astro';
import Certificates from '../components/Certificates.astro';
import Experience from '../components/Experience.astro';
import Horizon from '../components/Horizon.astro';
import Contact from '../components/Contact.astro';
import DitheredImage from '../components/DitheredImage.astro';
import { site } from '../content/site';
---
<Base title={site.name} description={site.line}>
  <Hero>
    <DitheredImage slot="portrait" base="/portrait" alt={`Portrait of ${site.name}`} />
  </Hero>
  <About />
  <Projects />
  <Skills />
  <Certificates />
  <Experience />
  <Horizon />
  <Contact />
</Base>
