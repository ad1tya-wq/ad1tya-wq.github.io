---
import { getCollection } from 'astro:content';
import Timeline, { type Entry } from './Timeline.astro';

const experience: Entry[] = (await getCollection('experience'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((e) => ({
    dates: `${e.data.start} to ${e.data.end ?? 'present'}`,
    title: `${e.data.role}, ${e.data.org}`,
    summary: e.data.summary,
    link: e.data.certificate ? { href: e.data.certificate, label: 'Certificate' } : undefined,
  }));

const education: Entry[] = (await getCollection('education'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((e) => ({
    dates: `${e.data.start} to ${e.data.end}`,
    title: e.data.degree,
    summary: e.data.institution,
    score: e.data.score,
  }));
---
<!-- one chapter, two timelines: the field's fallback phase runs across both -->
<section id="experience" class="section" data-chapter="experience" aria-labelledby="experience-h">
  <div class="col">
    <h2 id="experience-h">Experience</h2>
    <Timeline entries={experience} />
  </div>
  <div class="col education" id="education">
    <h2 id="education-h">Education</h2>
    <Timeline entries={education} />
  </div>
</section>

<style>
  .education { margin-top: var(--s-6); }
</style>
