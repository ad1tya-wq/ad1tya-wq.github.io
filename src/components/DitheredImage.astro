---
interface Props { base: string; alt: string; width?: number; height?: number }
const { base, alt, width = 791, height = 720 } = Astro.props;
---
<button type="button" class="dimg" style={`--w:${width};--h:${height}`} aria-pressed="false" data-dimg>
  <span class="sr-only">Show the portrait in color</span>
  <img class="dimg__dither" src={`${base}-dither.png`} srcset={`${base}-dither-sm.png ${Math.round(width / 2)}w, ${base}-dither.png ${width}w`} sizes="(max-width: 767px) 70vw, 740px" alt={alt} width={width} height={height} decoding="async" fetchpriority="high" />
  <picture class="dimg__color" aria-hidden="true">
    <source srcset={`${base}.avif`} type="image/avif" />
    <img src={`${base}.webp`} alt="" width={width} height={height} loading="lazy" decoding="async" />
  </picture>
</button>

<style>
  .dimg {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: var(--w) / var(--h);
    cursor: pointer;
    transition: transform var(--d-press) var(--ease-out);
  }
  .dimg:active { transform: scale(0.98); }
  .dimg img { width: 100%; height: 100%; object-fit: contain; }
  .dimg__color {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity var(--d-image) var(--ease-out);
  }
  .dimg:hover .dimg__color,
  .dimg:focus-visible .dimg__color,
  .dimg[aria-pressed='true'] .dimg__color,
  .dimg.is-hot .dimg__color { opacity: 1; }
  /* particle mode (desktop hero): the photo is revealed by a circle growing from the pointer, in step with the field */
  :global(.is-particles) .dimg:not(.is-hot) .dimg__color { opacity: 0; }
  :global(.is-particles) .dimg.is-hot .dimg__color {
    opacity: 1;
    transition: none;
    clip-path: circle(var(--wave-r, 0px) at var(--wave-x, 50%) var(--wave-y, 50%));
  }
</style>

<script>
  const els = document.querySelectorAll<HTMLButtonElement>('[data-dimg]');
  els.forEach((el) => {
    el.addEventListener('click', () => {
      const on = el.getAttribute('aria-pressed') === 'true';
      el.setAttribute('aria-pressed', String(!on));
    });
  });
  // touch devices: the dithered portrait rests as-is; a tap pins the colour photo (aria-pressed above)
</script>
