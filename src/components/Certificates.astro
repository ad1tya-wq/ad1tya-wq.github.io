---
import certificates from '../content/certificates.json';
import { sealRings } from '../lib/seal';
const plates = certificates.map((c) => ({ ...c, rings: sealRings(c.id) }));
---
<section id="certificates" class="section certificates" data-chapter="certificates" aria-labelledby="certificates-h">
  <h2 id="certificates-h">Certificates</h2>
  <ul class="plates" data-reveal>
    {plates.map((c) => (
      <li class="plate-item">
        <a class="plate" href={c.url} rel="noopener" target="_blank">
          <svg class="seal" viewBox="0 0 100 100" aria-hidden="true">
            {c.rings.map((r) => (
              <circle
                cx="50"
                cy="50"
                r={r.r}
                fill="none"
                stroke={r.tone === 'silver' ? 'var(--silver)' : 'var(--fog)'}
                stroke-width={r.width}
                stroke-dasharray={r.dash ? `${r.dash[0]} ${r.dash[1]}` : undefined}
                transform={`rotate(${r.rotate} 50 50)`}
              />
            ))}
            <circle cx="50" cy="50" r="2.2" fill="var(--core)" />
          </svg>
          <p class="plate__issuer mono">{c.issuer}</p>
          <p class="plate__title">{c.title}</p>
          <span class="plate__verify">Verify <span aria-hidden="true">↗</span><span class="sr-only">, opens the verification page</span></span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .plates {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-3);
  }
  /* certificates are documents: the one place a plate-like container is honest */
  .plate {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: var(--s-2);
    height: 100%;
    padding: var(--s-3);
    border: 1px solid var(--hairline);
    background: var(--graphite);
    color: var(--silver);
    text-decoration: none;
    transition:
      transform var(--d-reveal) var(--ease-out),
      border-color var(--d-hover) var(--ease-out);
  }
  .plate:hover,
  .plate:focus-visible {
    transform: translateY(-4px);
    border-color: var(--fog);
  }
  .seal {
    width: 100%;
    aspect-ratio: 1;
    transform-origin: 50% 50%;
    transition: transform 900ms var(--ease-out);
  }
  .plate:hover .seal,
  .plate:focus-visible .seal { transform: rotate(14deg); }
  .plate__issuer { font-size: var(--fs-mono-sm); }
  .plate__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    line-height: 1.2;
    color: var(--core);
    text-wrap: balance;
  }
  .plate__verify {
    position: relative;
    justify-self: start;
    font-family: var(--font-mono);
    font-size: var(--fs-mono-sm);
    letter-spacing: 0.06em;
    color: var(--core);
  }
  .plate__verify::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 120ms var(--ease-in);
  }
  .plate:hover .plate__verify::after,
  .plate:focus-visible .plate__verify::after {
    transform: scaleX(1);
    transition: transform 180ms var(--ease-out);
  }
  @media (max-width: 1023px) {
    .plates { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 767px) {
    .plates {
      display: flex;
      gap: var(--s-2);
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
    .plate-item { flex: 0 0 74vw; scroll-snap-align: start; }
  }
  @media (prefers-reduced-motion: reduce) {
    .plate:hover .seal,
    .plate:focus-visible .seal { transform: none; }
  }
</style>
