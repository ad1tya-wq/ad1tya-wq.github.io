<section id="horizon" class="section horizon" data-chapter="horizon" aria-labelledby="horizon-h">
  <div class="col col--center" data-toy>
    <h2 id="horizon-h">Horizon</h2>
    <p class="horizon__caption">Launch a probe and let gravity decide: escape, orbit, or capture. Press anywhere and drag to aim; the path shows before you let go.</p>
    <div class="horizon__controls">
      <div class="horizon__launch">
        <button type="button" class="btn" data-toy-launch>Launch a probe</button>
        <p class="horizon__status mono" aria-live="polite" data-toy-status></p>
      </div>

      <!-- the mass control survives everything: it and the reset button are the only things the hole never eats -->
      <div class="mass" data-devour>
      <label class="mass__label mono" for="mass">
        <span>mass</span>
        <output for="mass" data-mass-out>1.0 M☉</output>
      </label>
      <input class="mass__slider" id="mass" type="range" min="0" max="1000" step="1" value="0" aria-valuetext="1.0 solar masses" data-mass />
      <p class="mass__hint mono" aria-live="polite" data-mass-status>More mass, more reach.</p>
        <button type="button" class="btn btn--primary mass__reset" data-mass-reset hidden>Reset the universe?</button>
      </div>
    </div>
  </div>
</section>

<style>
  .horizon { min-height: 100dvh; display: grid; align-content: end; padding-bottom: var(--s-6); }
  .horizon__caption { max-width: 44ch; margin-inline: auto; }
  .horizon__controls {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-4);
    align-items: start;
    max-width: 640px;
    margin: var(--s-4) auto 0;
  }
  .horizon__status { min-height: 1.5em; margin-top: var(--s-2); font-size: var(--fs-mono-sm); }

  .mass { width: min(100%, 320px); margin-inline: auto; text-align: left; }
  @media (min-width: 768px) {
    /* launch on the left, mass on the right: the toy stays under the hole, not inside it */
    .horizon__controls { grid-template-columns: 1fr 1fr; }
    .horizon__launch { text-align: center; }
  }
  .mass__label {
    display: flex;
    justify-content: space-between;
    font-size: var(--fs-mono-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fog);
  }
  .mass__label output { color: var(--core); font-variant-numeric: tabular-nums; }
  /* a hairline track and a core thumb: the same material as the nav indicator */
  .mass__slider {
    display: block;
    width: 100%;
    height: 44px;
    margin: 0;
    background: transparent;
    appearance: none;
    cursor: ew-resize;
  }
  .mass__slider::-webkit-slider-runnable-track { height: 1px; background: var(--fog); }
  .mass__slider::-moz-range-track { height: 1px; background: var(--fog); }
  .mass__slider::-webkit-slider-thumb {
    appearance: none;
    width: 18px;
    height: 18px;
    margin-top: -8.5px;
    border-radius: 50%;
    background: var(--core);
    border: 0;
    transition: transform var(--d-press) var(--ease-out);
  }
  .mass__slider::-moz-range-thumb { width: 18px; height: 18px; border-radius: 50%; background: var(--core); border: 0; }
  .mass__slider:active::-webkit-slider-thumb { transform: scale(1.15); }
  .mass__slider:focus-visible { outline: 2px solid var(--core); outline-offset: 4px; border-radius: 2px; }
  .mass__hint { min-height: 1.5em; margin-top: var(--s-1); font-size: var(--fs-mono-sm); color: var(--fog); }
  .mass__reset { margin-top: var(--s-3); }
  .mass__reset[hidden] { display: none; }

  /* eaten blocks keep their box (no reflow) and lose their ink; the fade only matters for blocks without particles */
  :global(.is-eaten) { visibility: hidden !important; transition: none !important; }
  :global(.is-fading) { opacity: 0 !important; transition: opacity 400ms var(--ease-out) !important; }
</style>
