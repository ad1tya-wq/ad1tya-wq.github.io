---
import skills from '../content/skills.json';
---
<section id="skills" class="section skills" data-chapter="skills" aria-labelledby="skills-h">
  <div class="skills__grid">
    <div class="col skills__spectrum">
      <h2 id="skills-h">Skills</h2>
      <div class="spectrum" data-spectrum>
        {skills.bands.map((band) => (
          <div class="band" data-band>
            <p class="band__name mono">{band.name}</p>
            <ul class="band__lines">
              {band.items.map((item) => (
                <li class="line">
                  <span class="line__tick" aria-hidden="true"></span>
                  <span class="line__label">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
    <aside class="skills__soft" data-reveal aria-labelledby="soft-h">
      <h3 id="soft-h">{skills.softTitle}</h3>
      <ul class="soft">
        {skills.soft.map((s) => <li>{s}</li>)}
      </ul>
    </aside>
  </div>
</section>

<style>
  .skills__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    column-gap: var(--s-6);
    align-items: start;
  }
  .skills__spectrum { width: 100%; }
  .spectrum { display: grid; gap: var(--s-3); }
  .band {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    align-items: start;
    gap: var(--s-2);
    padding-block: var(--s-2);
    border-top: 1px solid var(--hairline);
  }
  .band:last-child { border-bottom: 1px solid var(--hairline); }
  .band__name { font-size: var(--fs-mono-sm); padding-top: 0.35em; }
  .band__lines {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--s-3);
    row-gap: var(--s-1);
  }
  .line {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 32px;
    color: var(--silver);
  }
  .line__tick {
    display: inline-block;
    width: 2px;
    height: 20px;
    background: var(--fog);
    transition: background-color var(--d-reveal) var(--ease-out);
  }
  /* the label keeps its width from the start (no layout shift); the reveal is paint-only */
  .line__label {
    display: inline-block;
    white-space: nowrap;
    clip-path: inset(0 100% 0 0);
    transform: translateX(-6px);
    transition:
      clip-path 420ms var(--ease-out),
      transform 420ms var(--ease-out);
  }
  .band.is-revealed .line__label {
    clip-path: inset(0 0 0 0);
    transform: none;
  }
  .band.is-revealed .line__tick { background: var(--core); }
  .skills__soft h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--core);
    margin-top: calc(var(--fs-h2) * 1.05 + var(--s-4));
    margin-bottom: var(--s-3);
  }
  .soft { display: grid; gap: var(--s-2); max-width: var(--measure); }
  .soft li {
    padding-left: var(--s-3);
    border-left: 1px solid var(--hairline);
  }
  @media (max-width: 1023px) {
    .skills__grid { grid-template-columns: minmax(0, 1fr); row-gap: var(--s-5); }
    .skills__soft h3 { margin-top: 0; }
  }
  @media (max-width: 767px) {
    .band { grid-template-columns: minmax(0, 1fr); }
  }
  @media (prefers-reduced-motion: reduce) {
    .line__label { clip-path: inset(0 0 0 0); transform: none; }
  }
</style>
